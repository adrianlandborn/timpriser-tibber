.DS_Store

# Local credentials and signing material
.env
.env.*
!.env.example
developer_key.pem
developer_key.der
*.pem
*.key
*.p12
*.pfx
# Everything in secrets/ is local except its README and the token-free template
/secrets/*
!/secrets/README.md
!/secrets/Secrets.mc.example

# Connect IQ generated build output
/TibberWidget.prg
/TibberWidget_backup.prg
/TibberWidget.prg.debug.xml
/bin/
/gen/
/mir/
/internal-mir/
/external-mir/
*.prg
*.prg.debug.xml
# Agent harness output and machine-local agent config
/.cache/
.agents/skills-local/*
!.agents/skills-local/.gitkeep
.claude/skills/local-*
.claude/settings.local.json
.claude/worktrees/
.github/copilot/settings.local.json
