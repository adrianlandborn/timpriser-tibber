{
  "description": "Repo guard shared with all agents; see .agents/hooks/guard.py",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/guard.py\" --agent codex",
            "timeout": 10,
            "statusMessage": "Checking repo guard"
          }
        ]
      }
    ]
  }
}
