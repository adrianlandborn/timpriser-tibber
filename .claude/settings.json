{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh:*)",
      "Bash(scripts/build.sh:*)",
      "Bash(scripts/test.sh:*)",
      "Bash(python3 .agents/scripts/validate.py)",
      "Bash(python3 scripts/lint.py:*)",
      "Bash(.agents/scripts/link-skills.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(python3 -)",
      "Bash(git add *)",
      "Bash(git commit -q -m 'Document local release process, add release-prepare script and changelog *)",
      "Bash(git push *)",
      "Bash(scripts/build.sh fr55 *)",
      "Bash(scripts/test.sh --device fr55)",
      "Bash(awk -F: '{print $1\": \"$3}')",
      "Bash(scripts/test.sh --device fenix7xpro)",
      "Bash(scripts/check.sh build *)",
      "Bash(scripts/build.sh vivoactive4 *)",
      "Read(//Users/adrian.landborn/Library/Application Support/Garmin/ConnectIQ/Sdks/connectiq-sdk-mac-9.3.0-2026-10-20-95888f262/bin/**)",
      "Bash(/opt/homebrew/opt/openjdk@17/bin/javap -c -p -classpath monkeybrains.jar com.garmin.monkeybrains.monkeydodeux.MonkeyDoDeux)"
    ],
    "deny": [
      "Read(./developer_key.*)",
      "Read(./source/config/Secrets.mc)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./gen/**)",
      "Read(./mir/**)",
      "Read(./internal-mir/**)",
      "Read(./external-mir/**)",
      "Read(./resources/fonts/Poppins*)",
      "Read(./resources-large/fonts/Poppins*)"
    ],
    "defaultMode": "default"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.agents/hooks/guard.py\" --agent claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
