{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh *)",
      "Bash(scripts/build.sh *)",
      "Bash(scripts/test.sh *)",
      "Bash(python3 .agents/scripts/validate.py)",
      "Bash(python3 scripts/lint.py *)",
      "Bash(.agents/scripts/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "Read(//Users/adrian.landborn/Library/Application Support/Garmin/ConnectIQ/Sdks/**)",
      "Bash(pkill -f *monkey*)",
      "Bash(pkill -f *MonkeyDo*)",
      "Bash(screencapture -x *)"
    ],
    "deny": [
      "Read(./developer_key.*)",
      "Read(./secrets/Secrets.mc)",
      "Read(./secrets/developer_key.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./gen/**)",
      "Read(./mir/**)",
      "Read(./internal-mir/**)",
      "Read(./external-mir/**)",
      "Read(./resources/fonts/Poppins*)",
      "Read(./resources-large/fonts/Poppins*)"
    ],
    "defaultMode": "default"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.agents/hooks/guard.py\" --agent claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
