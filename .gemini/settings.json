{
  "context": {
    "fileName": ["AGENTS.md"]
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "repo-guard",
            "type": "command",
            "command": "python3 \"$GEMINI_PROJECT_DIR/.agents/hooks/guard.py\" --agent gemini",
            "timeout": 10000,
            "description": "Blocks secrets, generated output edits and --no-verify"
          }
        ]
      }
    ]
  }
}
